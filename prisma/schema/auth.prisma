model RefreshToken {
    id        String   @id @default(uuid())
    jti       String   @unique
    tokenHash String
    userId    String
    expiresAt DateTime
    ipAddress String?
    userAgent String?
    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}
