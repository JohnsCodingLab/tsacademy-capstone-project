model SystemUser {
    id       String     @id @default(uuid())
    email    String     @unique
    password String
    role     SystemRole @default(SYSTEM_ADMIN)

    isActive  Boolean   @default(true)
    lastLogin DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum SystemRole {
    SYSTEM_ADMIN
}
